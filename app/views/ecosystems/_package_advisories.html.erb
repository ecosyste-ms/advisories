<div class="listing-controls p-3 mb-5 rounded">
  <div class="row">
    <div class="col-8">
      <p class="mb-0">
        <% if params[:severity].present? %>
          <strong><%= params[:severity].humanize %></strong>
        <% end %>
        Security Advisories
        for <strong><%= @package_name %></strong>
        <% if params[:version].present? %>
          version <strong><%= params[:version] %></strong>
        <% end %>
        <% if params[:repository_url].present? %>
          for <strong><%= params[:repository_url] %></strong>
        <% end %>
        in <strong><%= @ecosystem %></strong>
        <% if params.slice(:repository_url, :severity, :version).values.any?(&:present?) %>
          <%= link_to 'Clear Filters', ecosystem_package_path(@ecosystem, @package_name), class: 'btn btn-link btn-clear p-0' %>
        <% end %>
      </p>
    </div>

    <div class="col-4  text-end">
      <%= render 'advisories/sort' %>
    </div>
  </div>
</div>
<% if @pagy.count.zero? %>
  <p><%= params[:version].present? ? 'No advisories with a matching affected version range were found.' : 'No advisories found.' %></p>
<% end %>
<% @advisories.each do |advisory| %>
  <% related = @related_packages_by_advisory&.dig(advisory.id) %>
  <% is_potential = related && !@direct_advisory_ids.include?(advisory.id) %>
  <div class="position-relative">
    <%= render 'ecosystems/related_badge', related_packages: [related] if is_potential %>
    <%= render advisory %>
  </div>
<% end %>
