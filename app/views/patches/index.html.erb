<% @meta_title = 'Downstream patches' %>
<div class="container">
  <h1 class="mb-4">Downstream patches</h1>

  <%= form_with url: patches_path, method: :get, local: true, class: 'd-flex flex-wrap align-items-center gap-2 mb-3' do |form| %>
    <%= form.label :purl, 'PURL' %>
    <%= form.search_field :purl, value: @purl, class: 'form-control w-auto' %>
    <%= form.label :distribution, 'Source' %>
    <%= form.select :distribution, options_for_select(@distributions.map { |source| [source.humanize, source] }, @distribution),
      { include_blank: 'All sources' }, class: 'form-select w-auto' %>
    <%= form.label :sort, 'Sort' %>
    <%= form.select :sort, options_for_select([['Newest indexed', 'newest'], ['Oldest indexed', 'oldest'],
      ['Largest first', 'largest'], ['Smallest first', 'smallest']], @sort), {}, class: 'form-select w-auto' %>
    <%= form.submit 'Apply', name: nil, class: 'btn btn-outline-primary' %>
  <% end %>

  <% if @patches.any? %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th scope="col">Patch</th>
            <th scope="col" class="text-end">Size (KB)</th>
            <th scope="col">Downstream packages</th>
            <th scope="col">Inferred upstream PURLs</th>
          </tr>
        </thead>
        <tbody>
          <% @patches.each do |patch| %>
            <% occurrences = @occurrences.fetch(patch.id, []) %>
            <tr>
              <th scope="row">
                <%= link_to patch.display_name(occurrences), patch_path(patch.sha256), class: 'text-break' %>
                <div class="small text-muted"><code><%= patch.sha256.first(12) %></code></div>
              </th>
              <td class="text-end"><%= patch.byte_size.nil? ? 'Unknown' : number_with_precision(patch.byte_size / 1000.0, precision: 2, delimiter: ',') %></td>
              <td>
                <% releases = occurrences.map(&:patch_release) %>
                <% releases.map { |release| [release.distribution, release.package_name] }.uniq.sort.each do |distribution, name| %>
                  <div><%= distribution.humanize %> / <%= name %></div>
                <% end %>
              </td>
              <td>
                <% purls = occurrences.filter_map(&:purl).uniq.sort %>
                <% repositories = releases.filter_map { |release| release.source_repository&.fetch('purl') }.uniq.sort %>
                <% if purls.empty? && repositories.empty? %>
                  <span class="text-muted">No mapped PURL</span>
                <% else %>
                  <% purls.each do |purl| %><div><code><%= purl %></code></div><% end %>
                <% end %>
                <% repositories.each do |purl| %>
                  <div><%= link_to purl, patches_path(purl: purl), class: 'font-monospace' %></div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% elsif @pagy.count.zero? %>
    <% if @purl %>
      <p>No matching patches for <code><%= @purl %></code>. <%= link_to 'Clear PURL', patches_path(distribution: @distribution, sort: @sort) %></p>
    <% elsif @distribution %>
      <p>No patches found for <%= @distribution.humanize %>. <%= link_to 'Show all sources', patches_path(sort: params[:sort].presence && @sort) %></p>
    <% else %>
      <p>No patches have been indexed.</p>
    <% end %>
  <% else %>
    <p>No patches on this page. <%= link_to 'Back to the first page', patches_path(distribution: @distribution, sort: @sort, purl: @purl) %></p>
  <% end %>
  <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
</div>
