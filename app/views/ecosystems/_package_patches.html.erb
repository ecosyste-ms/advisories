<section id="downstream-patches" aria-label="Downstream patches">
  <% if @patches.any? %>
    <ul class="list-unstyled">
      <% @patches.each do |patch| %>
        <% occurrences = @occurrences.fetch(patch.id, []) %>
        <li class="border-bottom py-2">
          <%= link_to patch.display_name(occurrences), patch_path(patch), class: 'text-break' %>
          <% occurrences.map(&:patch_release).uniq.each do |release| %>
            <div class="small text-muted">Declared by <%= patch_release_label(release) %></div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No matching patches found.</p>
  <% end %>
</section>
