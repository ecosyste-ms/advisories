<% @meta_title = "#{@package_name} #{@patches_tab ? 'Patches' : 'Security Advisories'} - #{@ecosystem.humanize}" %>
<% if @package&.description.present? %>
  <% @meta_description = "Security advisories for #{@package_name} (#{@ecosystem}): #{@package.description.truncate(120)}" %>
<% else %>
  <% @meta_description = "View security advisories, CVEs, and vulnerability details for #{@package_name} in the #{@ecosystem} ecosystem." %>
<% end %>

<div class="container">
  <div class="mb-3">
    <div class="d-flex align-items-center mb-3">
      <% if @registry&.icon_url.present? %>
        <img src="<%= @registry.icon_url %>" alt="<%= @ecosystem %>" class="me-3" style="width: 64px; height: 64px; object-fit: contain;">
      <% end %>
      <div>
        <h2 class="h1 mb-0"><%= @package_name %></h2>
        <p class="text-muted mb-1">
          <%= link_to @ecosystem, ecosystem_path(@ecosystem) %>
        </p>
        <% if @package %>
          <% if @package.description.present? %>
            <p class="text-muted mb-1"><%= @package.description %></p>
          <% end %>
          <% if @package.repository_url.present? || @package.registry_url.present? %>
            <p class="text-muted mb-0">
              <% if @package.repository_url.present? %>
                <a href="<%= @package.repository_url %>" target="_blank" rel="noopener">View on <%= @package.repository_host %></a>
              <% end %>
              <% if @package.registry_url.present? %>
                <%= ' · ' if @package.repository_url.present? %>
                <a href="<%= @package.registry_url %>" target="_blank" rel="noopener">View on <%= @package.registry_name %></a>
              <% end %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% filters = params.permit(:version, :severity, :repository_url, :created_after, :updated_after, :sort, :order, :per_page).to_h %>
  <nav class="nav nav-tabs mb-4" aria-label="Package sections">
    <%= link_to 'Advisories', ecosystem_package_path(@ecosystem, @package_name, filters),
      class: class_names('nav-link', active: !@patches_tab), aria: { current: ('page' unless @patches_tab) } %>
    <%= link_to 'Patches', ecosystem_package_path(@ecosystem, @package_name, filters.merge(tab: 'patches')),
      class: class_names('nav-link', active: @patches_tab), aria: { current: ('page' if @patches_tab) } %>
  </nav>

  <div class="row">
    <div class="col-lg-8">
      <% if @patches_tab %>
        <%= render 'package_patches' %>
      <% else %>
        <%= render 'package_advisories' %>
      <% end %>
      <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
    </div>
    <div class="col-lg-4 listing-filters">
      <%= form_with url: ecosystem_package_path(@ecosystem, @package_name), method: :get, local: true, class: 'mx-3 mb-4' do |form| %>
        <%= hidden_field_tag :tab, 'patches' if @patches_tab %>
        <% filters.except(:version).each do |key, value| %>
          <%= hidden_field_tag key, value if value.present? %>
        <% end %>
        <%= form.label :version, 'Filter by Version', class: 'h4' %>
        <%= form.text_field :version, value: params[:version], class: 'form-control mb-2', 'aria-describedby': 'version-filter-help' %>
        <p id="version-filter-help" class="form-text"><%= @patches_tab ? 'Match an exact package version.' : 'Match affected ranges for this package. Potential advisories inferred from related packages are excluded.' %></p>
        <%= form.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
      <% unless @patches_tab %>
        <h3 class="h4 mx-3">Filter by Severity</h3>
        <div class="list-group list-group-flush">
          <% @severities.each do |severity,count| %>
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= 'active' if params[:severity] == severity %>" href="<%= url_for(request.params.merge(severity: (params[:severity] == severity ? nil : severity), page: nil)) %>">
              <%= severity.humanize %>
              <span class="badge bg-primary rounded-pill"><%= number_with_delimiter count %></span>
            </a>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
